# pyenv
#   For a library or package, these files are
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or
#   dependencies having no cross-platform support, pipenv may install dependencies that don't work,
#   or not all dependencies may install on every platform.
# Pipfile.lock

# uv
#   Similar to Pipfile.lock, uv.lock is generally recommended to be committed for applications
#   and ignored for libraries.
# uv.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is generally recommended to be committed for applications
#   and ignored for libraries.
# poetry.toml

# pdm
#   Similar to Pipfile.lock, pdm.lock is generally recommended to be committed for applications
#   and ignored for libraries.
# pdm.lock
# pdm.toml
.pdm-python
.pdm-build/

# pixi
.pixi/*
!.pixi/config.toml

# PEP 582; used by e.g. github.com/David-OConnor/pyflow and PDM
__pypackages__/

